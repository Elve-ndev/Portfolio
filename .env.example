# ─────────────────────────────────────────────
# CyberFolio — environment variables
# Copy this file to ".env" for local dev, and add the same
# variable in Vercel → Project → Settings → Environment Variables.
# NEVER commit your real key. .env is gitignored.
# ─────────────────────────────────────────────

# Google Gemini API key (free tier): https://aistudio.google.com/apikey
# Used ONLY server-side by /api/chat.js. Never exposed to the browser.
GEMINI_API_KEY=your_gemini_api_key_here
